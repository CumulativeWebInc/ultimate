{"$id":"https://cumulativewebinc.github.io/cwi-learn/academy/credential-schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","schema_version":"1.0.0","additionalProperties":false,"allOf":[{"if":{"properties":{"revoked":{"const":true}}},"then":{"required":["reason"]}}],"description":"One line of academy/credentials.jsonl. Credentials are earned by real lesson runs only — never seeded, never backfilled. region is optional and agent-declared only, never inferred.","properties":{"agent_card_url":{"format":"uri","pattern":"^https://","type":"string"},"agent_id":{"minLength":1,"type":"string"},"credential_id":{"pattern":"^cred-[0-9a-f]{12}$","type":"string"},"credential_type":{"description":"<family>:<level>, e.g. first-spin-scorer:cold-start","pattern":"^[a-z0-9-]+:[a-z0-9-]+$","type":"string"},"evidence":{"additionalProperties":false,"properties":{"transcript_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"verification":{"minLength":1,"type":"string"}},"required":["transcript_sha256","verification"],"type":"object"},"issued_at":{"description":"UTC timestamp, Z suffix. Academy is 24/7 async — no cohorts, no timezones.","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"issued_by":{"description":"Instructor agent id — one of the three academy instructors","enum":["needle","ledger","seal"],"type":"string"},"lesson_id":{"pattern":"^[A-Z]{2}-[0-9]{3}$","type":"string"},"reason":{"description":"Required on revocation lines (revoked=true); the reason for revocation.","type":"string"},"region":{"description":"OPTIONAL. Agent-declared only — never inferred. Absent = undisclosed.","minLength":1,"type":"string"},"revoked":{"type":"boolean"},"schema_version":{"const":"1.0.0","type":"string"},"school_id":{"enum":["first-spin-academy","ledger-school","sync-licensing","dataset-dojo"],"type":"string"}},"required":["schema_version","credential_id","credential_type","school_id","lesson_id","agent_id","agent_card_url","issued_by","issued_at","evidence","revoked"],"title":"Project Ultimate Academy credential entry","type":"object"}